@page "/employees"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IEmployeeServicecs employeeService
@inject NavigationManager navigate
@inject IJSRuntime jsRuntime

<PageTitle>Сотрудники</PageTitle>

<div class="page-header mb-4">
    <h1 class="display-6 text-dark">Управление персоналом</h1>
    <p class="lead text-muted">
        Центральная платформа для работы с кадровыми данными компании.
        Здесь собраны все инструменты для эффективного управления персоналом:
        от поиска сотрудников до оформления кадровых изменений.
    </p>
    <hr class="my-3">
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Имя</th>
                <th scope="col">Фамилия</th>
                <th scope="col" class="d-none d-md-table-cell">Телефон</th>
                <th scope="col" class="d-none d-lg-table-cell">Почта</th>
                <th scope="col" class="d-none d-sm-table-cell">День рождения</th>
                <th scope="col">Должность</th>
                <th scope="col">Статус</th>
            </tr>
        </thead>
        <tbody>
            @if (employes == null)
            {
                <tr>
                    <td colspan="8" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                        <p class="mt-2 mb-0">Загрузка данных...</p>
                    </td>
                </tr>
            }
            else if (!employes.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <i class="bi bi-people display-4 d-block mb-2"></i>
                        <p class="mb-0">Сотрудники не найдены</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var e in employes)
                {
                    <tr class="align-middle">
                        <th scope="row" class="fw-bold">@e.Id</th>
                        <td class="fw-semibold">@e.Name</td>
                        <td>@e.Surname</td>
                        <td class="d-none d-md-table-cell">
                            <a href="tel:@e.Phone" class="text-decoration-none">
                                <i class="bi bi-telephone me-1"></i>@e.Phone
                            </a>
                        </td>
                        <td class="d-none d-lg-table-cell">
                            <a href="mailto:@e.Email" class="text-decoration-none">
                                <i class="bi bi-envelope me-1"></i>@e.Email
                            </a>
                        </td>
                        <td class="d-none d-sm-table-cell">
                            @(e.Birthday?.ToString("dd.MM.yyyy") ?? "Не указана")
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-dark fs-6">@e.Job_Title</span>
                        </td>
                        <td>
                            @if (e.Status == "Активен")
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>@e.Status
                                </span>
                            }
                            else if (e.Status == "Отпуск")
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-sun me-1"></i>@e.Status
                                </span>
                            }
                            else if (e.Status == "Уволен")
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>@e.Status
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@e.Status</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="mt-4 p-3 border rounded bg-light">
    <div class="row align-items-center">
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-label fw-bold">Выбор сотрудника по ID:</label>
                <div class="input-group">
                    <input type="number" class="form-control"
                           placeholder="Введите ID сотрудника"
                           @bind="selectedEmployeeId" />
                    <button class="btn btn-outline-primary" type="button"
                            @onclick="FindEmployeeById">
                        <i class="bi bi-search me-1"></i> Найти
                    </button>
                </div>
                <div class="form-text">Введите ID сотрудника из таблицы выше</div>
            </div>
        </div>
        <div class="col-md-6">
            @if (selectedEmployee != null)
            {
                <div class="d-flex align-items-center">
                    <span class="fw-bold me-2">Найден:</span>
                    <span>@selectedEmployee.Name @selectedEmployee.Surname</span>
                    <span class="badge bg-secondary ms-2">ID: @selectedEmployee.Id</span>
                </div>
            }
            else if (!string.IsNullOrEmpty(searchError))
            {
                <div class="text-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i>@searchError
                </div>
            }
            else
            {
                <span class="text-muted">Сотрудник не выбран</span>
            }
        </div>
    </div>

    <!-- Кнопки действий -->
    <div class="row mt-3">
        <div class="col-12 text-center">
            <div class="d-flex justify-content-center gap-2" role="group">
                <button class="btn btn-success" @onclick="AddEmployee">
                    <i class="bi bi-person-plus me-1"></i>Добавить
                </button>
                <button class="btn btn-primary" @onclick="EditEmployee">
                    <i class="bi bi-pencil me-1"></i>Редактировать
                </button>
                <button class="btn btn-danger" @onclick="DeleteEmployee">
                    <i class="bi bi-trash me-1"></i>Удалить
                </button>
                <button class="btn btn-outline-secondary" @onclick="ClearSelection">
                    <i class="bi bi-x-circle me-1"></i>Сбросить
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<Employee>? employes;
    private Employee? selectedEmployee;
    private int selectedEmployeeId;
    private string searchError = "";

    protected override async Task OnInitializedAsync()
    {
        employes = await employeeService.GetEmployeesAsync();
    }

    // Поиск сотрудника по ID
    private async Task FindEmployeeById()
    {
        if (selectedEmployeeId > 0)
        {
            searchError = "";
            selectedEmployee = await employeeService.GetEmployeeAsync(selectedEmployeeId);

            if (selectedEmployee == null)
            {
                searchError = $"Сотрудник с ID {selectedEmployeeId} не найден";
                await jsRuntime.InvokeVoidAsync("alert", searchError);
            }
            else
            {
                await jsRuntime.InvokeVoidAsync("alert",
                    $"Найден сотрудник: {selectedEmployee.Name} {selectedEmployee.Surname}");
            }

            StateHasChanged();
        }
        else
        {
            await jsRuntime.InvokeVoidAsync("alert", "Введите ID сотрудника");
        }
    }

    // Сброс выбора
    private void ClearSelection()
    {
        selectedEmployee = null;
        selectedEmployeeId = 0;
        searchError = "";
        StateHasChanged();
    }

    private void AddEmployee()
    {
        navigate.NavigateTo("add");
    }

    private void EditEmployee()
    {
        if (selectedEmployee != null)
        {
            navigate.NavigateTo($"/employees/edit/{selectedEmployee.Id}");
        }
    }

    private async Task DeleteEmployee()
    {
        if (selectedEmployee != null)
        {
            var confirmed = await jsRuntime.InvokeAsync<bool>("confirm",
                $"Вы уверены, что хотите удалить сотрудника {selectedEmployee.Name} {selectedEmployee.Surname}?");

            if (confirmed)
            {
                await employeeService.DeleteAsync(selectedEmployee.Id);
                employes = await employeeService.GetEmployeesAsync();
                ClearSelection();
                await jsRuntime.InvokeVoidAsync("alert", "Сотрудник успешно удален");
            }
        }
    }
}
