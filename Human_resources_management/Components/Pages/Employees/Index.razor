@page "/employees"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IEmployeeServicecs employeeService
@inject NavigationManager navigate
@inject IJSRuntime jsRuntime

<PageTitle>Сотрудники</PageTitle>

<div class="page-header mb-4">
    <h1 class="display-6 text-dark">Управление персоналом</h1>
    <p class="lead text-muted">
        Центральная платформа для работы с кадровыми данными компании.
        Здесь собраны все инструменты для эффективного управления персоналом:
        от поиска сотрудников до оформления кадровых изменений.
    </p>
    <hr class="my-3">
</div>

<!-- Сообщение об архивации -->
@if (!string.IsNullOrEmpty(dismissedMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-archive me-2"></i>
        @dismissedMessage
        <button type="button" class="btn-close" @onclick="ClearDismissedMessage"></button>
    </div>
}

<!-- Ссылка на архив -->
<div class="mb-3">
    <a href="/employees/archived" class="btn btn-outline-secondary">
        <i class="bi bi-archive me-1"></i>Показать архив уволенных сотрудников
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Имя</th>
                <th scope="col">Фамилия</th>
                <th scope="col" class="d-none d-md-table-cell">Телефон</th>
                <th scope="col" class="d-none d-lg-table-cell">Почта</th>
                <th scope="col" class="d-none d-sm-table-cell">День рождения</th>
                <th scope="col" class="d-none d-xl-table-cell">Отпуск</th>
                <th scope="col">Должность</th>
                <th scope="col">Статус</th>
            </tr>
        </thead>
        <tbody>
            @if (employes == null)
            {
                <tr>
                    <td colspan="9" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                        <p class="mt-2 mb-0">Загрузка данных...</p>
                    </td>
                </tr>
            }
            else if (!employes.Any())
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">
                        <i class="bi bi-people display-4 d-block mb-2"></i>
                        <p class="mb-0">Сотрудники не найдены</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var e in employes)
                {
                    @if (e.Status != "Уволен") // Фильтруем уволенных
                    {
                        <tr class="align-middle @(GetEmployeeStatus(e) == "Отпуск" ? "table-warning" : "")">
                            <th scope="row" class="fw-bold">@e.Id</th>
                            <td class="fw-semibold">@e.Name</td>
                            <td>@e.Surname</td>
                            <td class="d-none d-md-table-cell">
                                <a href="tel:@e.Phone" class="text-decoration-none">
                                    <i class="bi bi-telephone me-1"></i>@e.Phone
                                </a>
                            </td>
                            <td class="d-none d-lg-table-cell">
                                <a href="mailto:@e.Email" class="text-decoration-none">
                                    <i class="bi bi-envelope me-1"></i>@e.Email
                                </a>
                            </td>
                            <td class="d-none d-sm-table-cell">
                                @(e.Birthday?.ToString("dd.MM.yyyy") ?? "Не указана")
                            </td>
                            <td class="d-none d-xl-table-cell">
                                @if (e.Begin_otp.HasValue && e.End_otp.HasValue)
                                {
                                    var today = DateOnly.FromDateTime(DateTime.Today);
                                    <div class="small">
                                        <div>
                                            <i class="bi bi-calendar-event me-1"></i>
                                            @e.Begin_otp.Value.ToString("dd.MM")
                                            -
                                            @e.End_otp.Value.ToString("dd.MM.yy")
                                        </div>
                                        @if (GetEmployeeStatus(e) == "Отпуск")
                                        {
                                            var daysLeft = (e.End_otp.Value.DayNumber - today.DayNumber);
                                            <span class="badge bg-info mt-1">
                                                <i class="bi bi-clock-history me-1"></i>
                                                @if (daysLeft > 0)
                                                {
                                                    @:Осталось: @daysLeft дн.
                                                }
                                                else
                                                {
                                                    @:Сегодня последний день
                                                }
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Не запланирован</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-dark fs-6">@e.Job_Title</span>
                            </td>
                            <td>
                                @{
                                    var currentStatus = GetEmployeeStatus(e);
                                }
                                @if (currentStatus == "Активен")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>@currentStatus
                                    </span>
                                }
                                else if (currentStatus == "Отпуск")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-sun me-1"></i>@currentStatus
                                    </span>
                                }
                                else if (currentStatus == "Болеет")
                                {
                                    <span class="badge bg-info">
                                        <i class="bi bi-heart-pulse me-1"></i>@currentStatus
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@currentStatus</span>
                                }
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

<div class="mt-4 p-3 border rounded bg-light">
    <div class="row align-items-center">
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-label fw-bold">Выбор сотрудника по ID:</label>
                <div class="input-group">
                    <input type="number" class="form-control"
                           placeholder="Введите ID сотрудника"
                           @bind="selectedEmployeeId" />
                    <button class="btn btn-outline-primary" type="button"
                            @onclick="FindEmployeeById">
                        <i class="bi bi-search me-1"></i> Найти
                    </button>
                </div>
                <div class="form-text">Введите ID сотрудника из таблицы выше</div>
            </div>
        </div>
        <div class="col-md-6">
            @if (selectedEmployee != null)
            {
                <div class="d-flex align-items-center">
                    <span class="fw-bold me-2">Найден:</span>
                    <span>@selectedEmployee.Name @selectedEmployee.Surname</span>
                    <span class="badge bg-secondary ms-2">ID: @selectedEmployee.Id</span>
                    @if (selectedEmployee.Status == "Уволен")
                    {
                        <span class="badge bg-danger ms-2">
                            <i class="bi bi-archive me-1"></i>В архиве
                        </span>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(searchError))
            {
                <div class="text-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i>@searchError
                </div>
            }
            else
            {
                <span class="text-muted">Сотрудник не выбран</span>
            }
        </div>
    </div>

    <!-- Кнопки действий -->
    <div class="row mt-3">
        <div class="col-12 text-center">
            <div class="d-flex justify-content-center gap-2" role="group">
                <button class="btn btn-success" @onclick="AddEmployee">
                    <i class="bi bi-person-plus me-1"></i>Добавить
                </button>
                <button class="btn btn-primary" @onclick="EditEmployee">
                    <i class="bi bi-pencil me-1"></i>Редактировать
                </button>
                <button class="btn btn-warning" @onclick="ArchiveEmployee"
                        disabled="@(selectedEmployee == null || selectedEmployee.Status == "Уволен")">
                    <i class="bi bi-archive me-1"></i>В архив
                </button>
                <button class="btn btn-danger" @onclick="DeleteEmployee">
                    <i class="bi bi-trash me-1"></i>Удалить
                </button>
                <button class="btn btn-outline-secondary" @onclick="ClearSelection">
                    <i class="bi bi-x-circle me-1"></i>Сбросить
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<Employee>? employes;
    private Employee? selectedEmployee;
    private int selectedEmployeeId;
    private string searchError = "";
    private string dismissedMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        // Получаем только не уволенных сотрудников
        employes = await employeeService.GetEmployeesAsync();
    }

    // Метод для определения статуса сотрудника
    private string GetEmployeeStatus(Employee e)
    {
        // Специальные статусы оставляем как есть
        if (e.Status == "Болеет" || e.Status == "Уволен" || e.Status == "Командировка")
            return e.Status;

        var today = DateOnly.FromDateTime(DateTime.Today);

        // Проверяем отпуск
        if (e.Begin_otp.HasValue && e.End_otp.HasValue &&
            today >= e.Begin_otp.Value && today <= e.End_otp.Value)
            return "Отпуск";

        return "Активен";
    }

    // Поиск сотрудника по ID
    private async Task FindEmployeeById()
    {
        if (selectedEmployeeId > 0)
        {
            searchError = "";
            selectedEmployee = await employeeService.GetEmployeeAsync(selectedEmployeeId);

            if (selectedEmployee == null)
            {
                searchError = $"Сотрудник с ID {selectedEmployeeId} не найден";
                await jsRuntime.InvokeVoidAsync("alert", searchError);
            }
            else
            {
                var message = $"Найден сотрудник: {selectedEmployee.Name} {selectedEmployee.Surname}\n" +
                             $"Статус: {GetEmployeeStatus(selectedEmployee)}";

                if (selectedEmployee.Status == "Уволен")
                {
                    message += "\n\nСотрудник находится в архиве уволенных.";
                }

                await jsRuntime.InvokeVoidAsync("alert", message);
            }

            StateHasChanged();
        }
        else
        {
            await jsRuntime.InvokeVoidAsync("alert", "Введите ID сотрудника");
        }
    }

    // Сброс выбора
    private void ClearSelection()
    {
        selectedEmployee = null;
        selectedEmployeeId = 0;
        searchError = "";
        StateHasChanged();
    }

    // Очистка сообщения об архивации
    private void ClearDismissedMessage()
    {
        dismissedMessage = "";
        StateHasChanged();
    }

    private void AddEmployee()
    {
        navigate.NavigateTo("add");
    }

    private void EditEmployee()
    {
        if (selectedEmployee != null)
        {
            navigate.NavigateTo($"/employees/edit/{selectedEmployee.Id}");
        }
        else
        {
            jsRuntime.InvokeVoidAsync("alert", "Сначала выберите сотрудника");
        }
    }

    // Архивация сотрудника (мягкое удаление)
    private async Task ArchiveEmployee()
    {
        if (selectedEmployee != null)
        {
            var confirmed = await jsRuntime.InvokeAsync<bool>("confirm",
                $"Переместить сотрудника {selectedEmployee.Name} {selectedEmployee.Surname} в архив уволенных?\n\n" +
                "Сотрудник будет скрыт из основной таблицы, но останется в базе данных.");

            if (confirmed)
            {
                // Меняем статус на "Уволен"
                selectedEmployee.Status = "Уволен";
                await employeeService.UpdateEmployeeAsync(selectedEmployee);

                // Сохраняем сообщение для показа
                dismissedMessage = $"Сотрудник {selectedEmployee.Name} {selectedEmployee.Surname} перемещен в архив уволенных.";

                // Обновляем список
                await LoadEmployees();
                ClearSelection();

                StateHasChanged();
            }
        }
    }

    // Полное удаление сотрудника
    private async Task DeleteEmployee()
    {
        if (selectedEmployee != null)
        {
            var confirmed = await jsRuntime.InvokeAsync<bool>("confirm",
                $"Вы уверены, что хотите УДАЛИТЬ сотрудника {selectedEmployee.Name} {selectedEmployee.Surname}?\n\n" +
                "Это действие нельзя отменить!");

            if (confirmed)
            {
                await employeeService.DeleteAsync(selectedEmployee.Id);
                await LoadEmployees();
                ClearSelection();
                await jsRuntime.InvokeVoidAsync("alert", "Сотрудник успешно удален");
            }
        }
    }
}