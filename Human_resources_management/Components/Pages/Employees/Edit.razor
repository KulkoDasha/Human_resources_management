@page "/employees/edit/{Id:int}"
@inject IEmployeeServicecs employeeService
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer

<PageTitle>Редактирование сотрудника</PageTitle>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Редактирование сотрудника
                    </h4>
                </div>
                <div class="card-body">
                    @if (employee == null)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <p class="mt-2">Загрузка данных...</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="employee" OnValidSubmit="SaveEmployee">
                            <DataAnnotationsValidator />

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Имя *</label>
                                        <InputText @bind-Value="employee.Name" class="form-control" />
                                        <ValidationMessage For="@(() => employee.Name)" class="text-danger" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Фамилия *</label>
                                        <InputText @bind-Value="employee.Surname" class="form-control" />
                                        <ValidationMessage For="@(() => employee.Surname)" class="text-danger" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Телефон *</label>
                                        <InputText @bind-Value="employee.Phone" class="form-control" />
                                        <ValidationMessage For="@(() => employee.Phone)" class="text-danger" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Email *</label>
                                        <InputText @bind-Value="employee.Email" class="form-control" />
                                        <ValidationMessage For="@(() => employee.Email)" class="text-danger" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label">День рождения *</label>
                                        <input type="date" @bind="birthdayDate" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Должность *</label>
                                        <InputText @bind-Value="employee.Job_Title" class="form-control" />
                                        <ValidationMessage For="@(() => employee.Job_Title)" class="text-danger" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Начало отпуска *</label>
                                        <InputDate @bind-Value="employee.Begin_otp" class="form-control" />
                                        <ValidationMessage For="@(() => employee.Begin_otp)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Конец отпуска*</label>
                                        <InputDate @bind-Value="employee.End_otp" class="form-control" />
                                        <ValidationMessage For="@(() => employee.End_otp)" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Рабочие дни недели *</label>
                                        <div class="border rounded p-3">
                                            <div class="row">
                                                @foreach (var day in WorkingDaysHelper.DayNames)
                                                {
                                                    <div class="col-md-4 mb-2">
                                                        <div class="form-check">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   id="day-@day.Key"
                                                                   checked="@IsDaySelected(day.Key)"
                                                                   @onchange="@((e) => ToggleDay(day.Key, (bool)e.Value))" />
                                                            <label class="form-check-label" for="day-@day.Key">
                                                                @day.Value
                                                                @if (WorkingDaysHelper.IsWeekend(day.Key))
                                                                {
                                                                    <span class="badge bg-warning text-dark ms-1">Выходной</span>
                                                                }
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="mt-2">
                                                <small class="text-muted">
                                                    Выбрано дней: @selectedDaysCount из 7
                                                </small>
                                            </div>
                                        </div>
                                        <ValidationMessage For="@(() => employee.WorkingDaysMask)" class="text-danger" />
                                    </div>
                                </div>
                            </div>
                            <div class="alert alert-info">
                                <i class="bi bi-calendar-week me-2"></i>
                                <strong>Рабочий график:</strong>
                                <span class="ms-2">
                                    @string.Join(", ", WorkingDaysHelper.GetWorkingDays(employee.WorkingDaysMask))
                                </span>
                            </div>
                            <div class="form-group mb-4">
                                <label class="form-label">Статус *</label>
                                <select @bind="employee.Status" class="form-select">
                                    <option value="Активен">Активен</option>
                                    <option value="Отпуск">Отпуск</option>
                                    <option value="Болеет">Болеет</option>
                                    <option value="Уволен">Уволен</option>
                                </select>
                            </div>

                            <div class="d-flex gap-2 justify-content-end">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check-circle me-1"></i>Сохранить
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                                    <i class="bi bi-x-circle me-1"></i>Отмена
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Employee? employee;
    private DateTime birthdayDate = DateTime.Today;
    private DateTime OTPbegin = DateTime.Today;
    private DateTime OTPend = DateTime.Today;
    private int selectedDaysCount;

    protected override async Task OnParametersSetAsync()
    {
        if (Id > 0)
        {
            employee = await employeeService.GetEmployeeAsync(Id);
            if (employee != null && employee.Birthday.HasValue)
            {
                // Проверяем на null и конвертируем
                birthdayDate = new DateTime(employee.Birthday.Value.Year,
                                          employee.Birthday.Value.Month,
                                          employee.Birthday.Value.Day);


            }
            else if (employee != null)
            {
                // Если Birthday null, устанавливаем сегодняшнюю дату
                birthdayDate = DateTime.Today;
            }
        }
        else
        {
            navigationManager.NavigateTo("/employees");
        }
    }

    private async Task SaveEmployee()
    {
        try
        {
            // Получаем текущие данные сотрудника
            var oldEmployee = await employeeService.GetEmployeeAsync(employee.Id);
            var wasDismissed = oldEmployee?.Status == "Уволен";
            var isNowDismissed = employee.Status == "Уволен";

            // Сохраняем изменения
            await employeeService.UpdateEmployeeAsync(employee);

            // Если сотрудник стал уволенным
            if (!wasDismissed && isNowDismissed)
            {
                await jsRuntime.InvokeVoidAsync("alert",
                    $"Сотрудник {employee.Name} {employee.Surname} перемещен в архив уволенных!");
            }
            else
            {
                await jsRuntime.InvokeVoidAsync("alert", "Сотрудник успешно обновлен!");
            }

            navigationManager.NavigateTo("/employees");
        }
        catch (Exception ex)
        {
            await jsRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private void Cancel()
    {
        navigationManager.NavigateTo("/employees");
    }
    private bool IsDaySelected(int dayIndex)
    {
        if (employee == null) return false;
        return (employee.WorkingDaysMask & (1 << dayIndex)) != 0;
    }

    // Переключение дня
    private void ToggleDay(int dayIndex, bool isChecked)
    {
        if (employee == null) return;

        if (isChecked)
        {
            employee.WorkingDaysMask |= (1 << dayIndex);
        }
        else
        {
            employee.WorkingDaysMask &= ~(1 << dayIndex);
        }

        // Обновляем количество рабочих дней
        employee.WorkingDaysPerWeek = CountWorkingDays(employee.WorkingDaysMask);
        selectedDaysCount = employee.WorkingDaysPerWeek;

        StateHasChanged();
    }

    // Подсчет рабочих дней
    private int CountWorkingDays(int mask)
    {
        int count = 0;
        for (int i = 0; i < 7; i++)
        {
            if ((mask & (1 << i)) != 0) count++;
        }
        return count;
    }

    protected override async Task OnInitializedAsync()
    {
        employee = await employeeService.GetEmployeeAsync(Id);
        if (employee != null)
        {
            selectedDaysCount = CountWorkingDays(employee.WorkingDaysMask);
        }
    }
    
}